# AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3 bucket used as the DVC remote
S3_DVC_BUCKET=your-dvc-bucket-name

# S3 bucket where the Lambda fetches the model checkpoints
MODEL_S3_BUCKET=your-model-bucket-name

# MLflow tracking URI (leave empty to use local ./mlruns)
MLFLOW_TRACKING_URI=
