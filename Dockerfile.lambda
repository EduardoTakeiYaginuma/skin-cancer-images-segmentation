FROM --platform=linux/amd64 public.ecr.aws/lambda/python:3.11

# System deps for OpenCV
RUN yum install -y mesa-libGL && yum clean all

COPY requirements-lambda.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir "numpy==1.26.4" && \
    pip install --no-cache-dir torch==2.5.1+cpu torchvision==0.20.1+cpu \
        --extra-index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements-lambda.txt

COPY skin_app/ skin_app/
COPY config/ config/
COPY data/metadata.csv data/
COPY lambda_handler.py .

CMD ["lambda_handler.lambda_handler"]
